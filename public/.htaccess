RewriteEngine On

# --- non-www -> www (wie bisher) ---
RewriteCond %{HTTP_HOST} ^huerland-hausverwaltung\.de$ [NC]
RewriteRule ^(.*)$ https://www.huerland-hausverwaltung.de/$1 [L,R=301]

# --- Alte .html-Seiten dauerhaft auf die neuen Seiten weiterleiten (SEO) ---
RewriteRule ^weg-verwaltung(-sicherung)?\.html$ /weg-verwaltung/ [R=301,L]
RewriteRule ^mietverwaltung\.html$              /mietverwaltung/ [R=301,L]
RewriteRule ^kontakt\.html$                     /kontakt/ [R=301,L]
RewriteRule ^impressum\.html$                   /impressum/ [R=301,L]
RewriteRule ^datenschutz\.html$                 /datenschutz/ [R=301,L]
RewriteRule ^profil\.html$                      /profil/ [R=301,L]
RewriteRule ^gebuehren\.html$                   / [R=301,L]
RewriteRule ^vermietung-verkauf\.html$          / [R=301,L]
RewriteRule ^index_logoalt\.html$               / [R=301,L]

# --- /index.html -> / (wie bisher) ---
RewriteRule ^index\.html$ https://www.huerland-hausverwaltung.de/ [R=301,L]

# --- Startseite klar definieren ---
DirectoryIndex index.html

# --- Eigene 404-Seite ---
ErrorDocument 404 /404.html

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 days"
  ExpiresByType text/html "access plus 5 minutes"
  ExpiresByType text/xml "access plus 6 hours"
  ExpiresByType text/css "access plus 1 weeks"
  ExpiresByType text/javascript "access plus 1 weeks"
  ExpiresByType application/javascript "access plus 1 weeks"
  ExpiresByType application/x-javascript "access plus 1 weeks"
  ExpiresByType text/ecmascript "access plus 1 weeks"
  ExpiresByType image/gif "access plus 1 years"
  ExpiresByType image/png "access plus 1 years"
  ExpiresByType image/jpeg "access plus 1 years"
  ExpiresByType image/svg+xml "access plus 1 months"
  ExpiresByType image/x-icon "access plus 1 years"
  ExpiresByType application/pdf "access plus 1 years"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>
